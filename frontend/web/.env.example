# Copia este archivo como .env.local y completa los valores.
# Todo lo que empieza con VITE_ queda visible en el navegador: nunca poner
# secretos aquí (por ejemplo la service_role de Supabase).

# Proyecto de Supabase "Devminus" (la URL y la clave publicable están en
# Supabase > Project Settings > API). La clave publicable es pública por diseño:
# lo que protege los datos es RLS, no esconder la clave.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# URL pública del Worker de Cloudflare que recibe el formulario de contacto.
# Vacía = modo prototipo: valida y muestra los estados, pero no envía datos.
VITE_CONTACT_ENDPOINT=
